# Supabase プロジェクトの URL と公開キー（anon / publishable）。ブラウザに渡ってよい値です。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。社員アカウントの作成・停止に使います。NEXT_PUBLIC_ を付けないでください。
SUPABASE_SERVICE_ROLE_KEY=

# アプリ名（任意。未設定なら MY GROWTH WORKBOOK / 成長ワークブック）
NEXT_PUBLIC_APP_NAME=MY GROWTH WORKBOOK
NEXT_PUBLIC_APP_NAME_JA=成長ワークブック

# 任意: 写真からの設問読み取り（OCR）に Claude API を使う場合のみ設定。未設定でも手入力で登録できます。
ANTHROPIC_API_KEY=
